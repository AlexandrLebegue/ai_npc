# Build output directories (but keep our source tree build/vita, build/pc-gles
# which hold CMakeLists.txt + README). Ignore CMake-generated subfolders.
build/**/CMakeCache.txt
build/**/CMakeFiles/
build/**/*.a
build/**/*.o
build/**/cmake-build-*/
cmake-build-*/
out/

